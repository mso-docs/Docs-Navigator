# Everything here is optional. Search and the MCP tools need no keys.

# Folder of documents to search. Defaults to ./docs (the sample Aurora AI set).
# DOCS_DIR=/path/to/your/docs

# Self-hosting only: lets "Ask with AI" run without sign-in, using this Hugging Face token
# (needs the "Make calls to Inference Providers" permission). Do not set this on a public Space.
# DOCSNAV_SERVER_TOKEN=

# Comma-separated model ids to try, in order. Defaults to open models served by Inference Providers.
# DOCSNAV_MODEL=meta-llama/Llama-3.3-70B-Instruct
